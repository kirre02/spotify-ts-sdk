{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "module": "preserve",
    "noEmit": true,
    "lib": [
      "es2022"
    ],
    "baseUrl": "./src",
    "paths": {
      "@auth/*": [
        "auth/*"
      ],
      "@errors": [
        "errors/index.ts"
      ],
      "@guards": [
        "guards/index.ts"
      ],
      "@schemas/*": [
        "types/*"
      ],
      "@services/*": [
        "services/*"
      ],
      "@transporter": [
        "transporter.ts"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
